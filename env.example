# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to source control.

# Base URL of your Oracle Fusion instance (no trailing slash)
FUSION_BASE_URL=https://eiiv-dev1.login.us6.oraclecloud.com

# REST API version path segment. "11.13.18.05" is the common current
# version; you can also try "latest" for testing.
FUSION_API_VERSION=11.13.26.07.0

# Auth mode: "basic" or "bearer"
# - basic: uses FUSION_USERNAME / FUSION_PASSWORD (does NOT work if MFA is
#   enabled on the account)
# - bearer: uses FUSION_BEARER_TOKEN (get this via your OAuth2 / IDCS-OCI IAM
#   client credentials flow)
FUSION_AUTH_MODE=basic

FUSION_USERNAME=vprathibha@deloitte.com
FUSION_PASSWORD=Welcome@123

# Only needed if FUSION_AUTH_MODE=bearer
FUSION_BEARER_TOKEN=

# Optional tuning
FUSION_REQUEST_TIMEOUT=30
MCP_HOST=0.0.0.0
MCP_PORT=8000
